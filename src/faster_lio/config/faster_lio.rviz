Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: Registered cloud
      Enabled: true
      Topic:
        Value: /laserMapping/cloud_registered
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 10
      Size (Pixels): 2
      Style: Points
      Color Transformer: Intensity
    - Class: rviz_default_plugins/Path
      Name: Path
      Enabled: true
      Topic:
        Value: /laserMapping/path
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
Window Geometry:
  Width: 1200
  Height: 800
