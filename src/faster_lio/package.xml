<?xml version="1.0"?>
<package format="3">
  <name>faster_lio</name><version>0.1.0</version>
  <description>ROS2 port of DifferentialRobotics Faster-LIO lidar inertial odometry.</description>
  <maintainer email="gao.xiang.thu@gmail.com">Gao Xiang (upstream)</maintainer>
  <license>GPL-2.0-only</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>rclcpp</depend><depend>sensor_msgs</depend><depend>nav_msgs</depend>
  <depend>geometry_msgs</depend><depend>tf2_ros</depend><depend>pcl_conversions</depend>
  <depend>livox_ros_driver2</depend><depend>rosbag2_cpp</depend>
  <depend>eigen</depend><depend>libpcl-all-dev</depend><depend>libgoogle-glog-dev</depend><depend>libtbb-dev</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>ekf</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend><exec_depend>rviz2</exec_depend>
